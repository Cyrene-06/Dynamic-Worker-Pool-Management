{
  "version": "0.2.0",
  "configurations": [
    {
      // 当前唯一可运行的入口。Gateway / Both 会在 M1 的 sandbox-gateway 落地后补齐 ——
      // 现在放一个指向不存在目录的配置，只会让人以为代码丢了。
      "name": "Operator",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/operator",
      "args": [
        "--isolation-config=${workspaceFolder}/config/isolation/levels.yaml",
        "--leader-elect=false",
        "--metrics-bind-address=:8080",
        "--health-probe-bind-address=:8081"
      ],
      "env": {
        // 默认用 simulated 隔离：本地 kind / 没有 /dev/kvm 的机器也能跑通全链路。
        // 真实隔离必须去带 /dev/kvm 的环境（见 README §2.4），这里不提供"假装能跑"的开关。
        "GOFLAGS": "-mod=mod"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Gateway",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/gateway",
      "args": [
        "--bind-address=:8090",
        "--sandbox-namespace=sandbox-pool",
        "--tenant-tokens-file=${workspaceFolder}/config/gateway/tenant-tokens.example"
      ],
      "env": {
        "GOFLAGS": "-mod=mod",
        // 引用**运行时**环境变量而不是写字面值：写进去就是提交密钥。
        // 启动前请先设置 SANDBOX_TOKEN_ISSUER_SECRET，例如
        //   powershell: $env:SANDBOX_TOKEN_ISSUER_SECRET = openssl rand -hex 32
        "SANDBOX_TOKEN_ISSUER_SECRET": "${env:SANDBOX_TOKEN_ISSUER_SECRET}"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Sweeper（干跑一轮）",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/sweeper",
      "args": [
        "--dry-run",
        "--kubeconfig=${env:HOME}/.kube/config"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Debug 当前测试",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "args": ["-test.run", "${selectedText}", "-test.v"]
    }
  ]
}
